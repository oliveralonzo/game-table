{
  "name": "game-table",
  "version": "0.1.0",
  "description": "Frontend infrastructure for pluggable multiplayer table games",
  "type": "module",
  "files": ["frontend/dist"],
  "exports": {
    ".": {
      "types": "./frontend/dist/index.d.ts",
      "import": "./frontend/dist/index.js"
    },
    "./styles.css": "./frontend/dist/index.css",
    "./i18n": {
      "types": "./frontend/dist/i18n/index.d.ts",
      "import": "./frontend/dist/i18n/index.js"
    },
    "./*": {
      "types": "./frontend/dist/*.d.ts",
      "import": "./frontend/dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p frontend/tsconfig.json && cp frontend/src/index.css frontend/dist/index.css",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@clerk/react": "^6.12.5",
    "i18next": "^26.3.4",
    "konsta": "^5.2.0",
    "lucide-react": "^0.544.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.6.3",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3"
  }
}
